{
  "name": "agent-fleet",
  "version": "0.13.0",
  "description": "Local live dashboard of every coding-agent session on this machine and how they relate.",
  "repository": { "type": "git", "url": "https://github.com/fabianxvogt/agent-fleet.git" },
  "homepage": "https://github.com/fabianxvogt/agent-fleet#readme",
  "bugs": { "url": "https://github.com/fabianxvogt/agent-fleet/issues" },
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "bin": { "agent-fleet": "bin/agent-fleet.mjs" },
  "scripts": {
    "start": "node bin/agent-fleet.mjs serve",
    "snapshot": "node bin/agent-fleet.mjs snapshot",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "benchmark:layout": "node scripts/benchmark-layout.mjs"
  }
}
